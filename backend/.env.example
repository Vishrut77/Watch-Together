# ---------- General ----------
# development | production  (production refuses to start with the default SECRET_KEY)
APP_ENV=development
# Signs session tokens. Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-secret

# ---------- Database ----------
# SQLite (free, zero setup) for local use. PostgreSQL for production, e.g.
# postgresql://user:password@host:5432/dbname   (postgres:// is also accepted)
DATABASE_URL=sqlite:///./watch_together.db

# ---------- LiveKit (media server) ----------
# LiveKit Cloud free "Build" plan: cloud.livekit.io -> create project -> Settings -> Keys
# LIVEKIT_URL is the websocket URL, e.g. wss://your-project.livekit.cloud
# Self-hosted open-source server: ws://localhost:7880 (dev key/secret: devkey / secret)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Lifetime of a LiveKit access token. It is only needed when (re)connecting to media.
LIVEKIT_TOKEN_TTL_MINUTES=60

# ---------- Frontend / CORS ----------
# Where the frontend is served from (used for CORS defaults and docs only)
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed browser origins. Not needed when FastAPI serves the
# frontend itself (Cloudflare Tunnel mode) because that is same-origin.
CORS_ORIGINS=http://localhost:5173
# Folder with the built frontend (npm run build). If it exists FastAPI serves it.
FRONTEND_DIST=../frontend/dist

# ---------- Behaviour ----------
SESSION_TTL_HOURS=12
RATE_LIMIT_ENABLED=true
# Read client IP from CF-Connecting-IP / X-Forwarded-For (needed behind Cloudflare Tunnel or a proxy)
TRUST_PROXY_HEADERS=true
# Seconds before a closed tab is considered "left" (frees the seat)
PRESENCE_GRACE_SECONDS=45
# Seconds the movie survives if the streaming host drops and comes back
STREAMER_GRACE_SECONDS=20
# Seconds a person who closed the tab keeps their seat and identity (15 minutes)
REJOIN_WINDOW_SECONDS=900
